key # floor grass | torch
key % floor limestone | door
key & floor limestone | altar
key * floor wood | door
key - floor wood | table
key ^ floor wood | chest
key " floor wood | bed
key ' floor limestone | torch
key ` floor gravel | torch
key ! floor stone block | barrel
key ? floor limestone | chair
key $ floor wood | brazier
key @ floor limestone | table
