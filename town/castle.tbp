tachyon-blueprint 1
# Ravensburg, a moated castle of two courts above its market town, for Grimoire's medieval games.
# Made by town/make-castle.mjs; edit that and run it again. `label x y Name` names a place.
name castle
size 120 128 2
key , floor grass
key T wall leaves
key : floor gravel
key . floor soil
key W wall wood
key + floor wood
key ~ floor water
key # wall stone block
key s floor stone block
key < stair-up wood
key > stair-down wood
key } stair-down stone block
key ; floor grass | flowers
key _ floor stone block | oven
key = floor grass | torch
key % floor stone block | table
key & floor stone block | door
key * floor stone block | barrel
key - floor stone block | bed
key ^ floor stone block | chest
key " floor wood | door
key ' floor wood | brazier
key ` floor wood | rug
key ! floor stone block | brazier
key ? floor wood | bookshelf
key $ floor wood | chest
key @ floor wood | chair
key A floor wood | table
key B floor wood | candle
key C floor stone block | candle
key D floor gravel | well
key E floor gravel | torch
key F floor water | plank bridge
key G floor mud
key H floor stone block | altar
key I floor wood | bed
key J floor stone block | pew
key K floor soil | torch
key L floor soil | hay bale
key M floor soil | barrel
key N floor grass | hay bale
key O floor soil | door
key P floor soil | flowers
key Q floor soil | cart
key R floor gravel | anvil
key S floor gravel | brazier
key U floor gravel | door
key V floor gravel | barrel
key X floor stone block | torch
key Y floor wood | barrel
key Z floor gravel | chair
key a floor stone block | statue
key b floor wood | oven
key c floor wood | hay bale
key d floor water | barrel
level 0
