tachyon-blueprint 1
# The Keep, a castle's inside on three floors round an open court, for Grimoire's medieval games.
# Made by town/make-keep.mjs; edit that and run it again. `label x y Name` names a place.
name keep
size 60 46 3
key # wall stone block
key s floor stone block
key + floor wood
key : floor cobble
key c floor carpet
key = floor slate
key { stair-up stone block
key } stair-down stone block
key < stair-up wood
key > stair-down wood
key . floor wood | brazier
key , floor wood | chair
key ; floor stone block | oven
key _ floor stone block | brazier
key % floor stone block | candle
key & floor stone block | altar
key * floor wood | table
key ~ floor stone block | pew
key - floor stone block | table
key ^ floor stone block | barrel
key " floor wood | door
key ' floor stone block | door
key ` floor cobble | torch
key ! floor cobble | chair
key ? floor stone block | anvil
key $ floor stone block | well
key @ floor stone block | chest
key A floor stone block | bed
key B floor wood | candle
key C floor wood | bookshelf
key D floor stone block | torch
key E floor stone block | rug
key F floor wood | chest
key G floor wood | bed
key H floor carpet | chest
key I floor carpet | bed
key J floor carpet | candle
key K floor carpet | door
key L floor slate | candle
key M floor carpet | bookshelf
key N floor carpet | brazier
key O floor carpet | table
key P floor carpet | rug
level 0
