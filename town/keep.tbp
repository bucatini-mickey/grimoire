tachyon-blueprint 1
# The Keep, a minor castle's inside on three floors round an open court (a square is a metre), for Grimoire's medieval games.
# Made by town/make-keep.mjs; edit that and run it again. `label x y Name` names a place.
name keep
size 41 36 3
key # wall stone block
key s floor stone block
key + floor wood
key : floor cobble
key c floor carpet
key { stair-up stone block
key } stair-down stone block
key < stair-up wood
key > stair-down wood
key . floor wood | brazier
key , floor stone block | oven
key ; floor stone block | brazier
key _ floor stone block | candle
key = floor stone block | altar
key % floor stone block | barrel
key & floor wood | chair
key * floor wood | table
key ~ floor stone block | table
key - floor stone block | pew
key ^ floor wood | chest
key " floor stone block | hay bale
key ' floor stone block | torch
key ` floor wood | candle
key ! floor stone block | chest
key ? floor wood | door
key $ floor stone block | door
key @ floor wood | bookshelf
key A floor cobble | torch
key B floor cobble | chair
key C floor cobble | barrel
key D floor stone block | bed
key E floor stone block | well
key F floor stone block | anvil
key G floor wood | bed
key H floor cobble | cart
key I floor soil | door
key J floor soil
key K wall wood
key L floor soil | hay bale
key M floor stone block | rug
key N floor soil | torch
key O floor soil | cart
key P floor carpet | chest
key Q floor carpet | rug
key R floor carpet | bed
key S floor carpet | bookshelf
key U floor carpet | brazier
key V floor carpet | table
key W floor carpet | candle
key X floor carpet | door
level 0
