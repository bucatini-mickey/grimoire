tachyon-blueprint 1
# Saltgrave, a gas-lit Victorian harbour town on an island, for Grimoire's Laissez un Faire games.
# Made by town/make-victorian.mjs; edit that and run it again. `label x y Name` names a place.
name victorian
size 112 92 2
key , floor grass
key T wall leaves
key . floor cobble
key # wall brick
key + floor wood
key ~ floor water
key R wall granite
key G floor granite
key w wall glass
key _ floor slate
key S wall stone block
key s floor stone block
key I wall iron
key : floor gravel
key < stair-up wood
key > stair-down wood
key { stair-up stone block
key } stair-down stone block
key ; floor granite | coffin
key = floor mud
key % floor grass | fern
key & floor granite | sigil
key * floor granite | candle
key - floor granite | altar
key ^ floor cobble | gas lamp
key " floor granite | door
key ' floor wood | door
key ` floor wood | chest
key ! wall slate
key ? floor slate | door
key $ floor wood | bed
key @ floor wood | brazier
key A floor wood | candle
key B floor slate | candle
key C floor slate | altar
key D floor slate | bookshelf
key E floor stone block | candle
key F floor wood | chair
key H floor wood | table
key J floor stone block | pew
key K floor slate | fern
key L floor stone block | altar
key M floor stone block | door
key N floor cobble | chair
key O floor grass | coffin
key P floor grass | statue
key Q floor stone block | clock
key U floor stone block | table
key V floor stone block | barrel
key W floor wood | barrel
key X floor slate | table
key Y floor slate | chair
key Z floor water | plank bridge
key a floor wood | rug
key b floor wood | bookshelf
key c floor stone block | gas lamp
key d floor wood | hay bale
level 0
