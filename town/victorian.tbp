tachyon-blueprint 1
# Saltgrave, a gas-lit Victorian harbour town on an island, for Grimoire's Laissez un Faire games.
# Made by town/make-victorian.mjs; edit that and run it again. `label x y Name` names a place.
name victorian
size 112 92 2
key , floor grass
key T wall leaves
key . floor cobble
key # wall brick
key + floor wood
key ~ floor water
key R wall granite
key G floor granite
key w wall glass
key _ floor slate
key S wall stone block
key s floor stone block
key I wall iron
key : floor gravel
key < stair-up wood
key > stair-down wood
key { stair-up stone block
key } stair-down stone block
key ; floor granite | coffin
key = floor mud
key % floor grass | fern
key & floor granite | sigil
key * floor granite | altar
key - floor granite | candle
key ^ floor mud | coffin
key " floor cobble | gas lamp
key ' floor granite | door
key ` floor wood | door
key ! floor wood | chest
key ? wall slate
key $ floor slate | door
key @ floor wood | bed
key A floor wood | brazier
key B floor wood | candle
key C floor slate | candle
key D floor slate | altar
key E floor slate | bookshelf
key F floor stone block | candle
key H floor wood | chair
key J floor wood | table
key K floor stone block | pew
key L floor slate | fern
key M floor stone block | altar
key N floor stone block | door
key O floor cobble | sign
key P floor cobble | chair
key Q floor grass | coffin
key U floor grass | statue
key V floor stone block | clock
key W floor stone block | table
key X floor stone block | barrel
key Y floor wood | barrel
key Z floor slate | table
key a floor slate | chair
key b floor stone block | chest
key c floor water | plank bridge
key d wall wood
key e floor wood | rug
key f floor wood | bookshelf
key g floor slate | sigil
key h floor stone block | gas lamp
key i floor stone block | beacon
key j floor wood | hay bale
