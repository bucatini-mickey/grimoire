{
	"name": "grimoire",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"description": "An ASCII Storyteller's grimoire for Blood on the Clocktower: hard-coded rules, phone-friendly HTML.",
	"scripts": {
		"test": "node --test \"tests/**/*.test.ts\"",
		"check": "tsc --noEmit",
		"build": "node build.mjs",
		"dev": "node build.mjs --serve",
		"avatar": "node tools/avatar-inline.mjs",
		"tools": "node tools/serve.mjs --https",
		"sim": "node tests/sim/run.ts",
		"mutants": "node tests/sim/mutants.ts",
		"balance": "node tools/balance/run.ts",
		"avatar-test": "node tools/avatar-test-inline.mjs"
	},
	"devDependencies": {
		"@types/node": "^24.19.1",
		"esbuild": "^0.25.12",
		"typescript": "5.9"
	},
	"dependencies": {
		"peerjs": "^1.5.4",
		"qrcode-generator": "^1.4.4"
	}
}
